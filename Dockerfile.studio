FROM supabase/studio:latest

HEALTHCHECK NONE

# 1. Remplacer localhost:8000 hardcodé dans les bundles JS compilés
RUN find /app -name "*.js" -type f | xargs grep -l "localhost:8000" 2>/dev/null | \
    xargs -r sed -i \
      -e 's|http://localhost:8000|https://storage.vps.buyticle.com|g' \
      -e 's|"localhost:8000"|"storage.vps.buyticle.com"|g' || true

# 2. Patcher le .env interne (prioritaire sur les ENV Docker dans Next.js)
RUN sed -i \
      -e 's|SUPABASE_URL=http://localhost:8000|SUPABASE_URL=https://storage.vps.buyticle.com|g' \
      -e 's|SUPABASE_PUBLIC_URL=http://localhost:8000|SUPABASE_PUBLIC_URL=https://storage.vps.buyticle.com|g' \
      -e 's|STUDIO_PG_META_URL=.*|STUDIO_PG_META_URL=http://meta:8080|g' \
      -e '/^SUPABASE_ANON_KEY=/d' \
      -e '/^SUPABASE_SERVICE_KEY=/d' \
      -e 's|STORAGE_URL=.*|STORAGE_URL=http://storage:5001|g' \
      /app/apps/studio/.env 2>/dev/null || true

ENV STUDIO_PG_META_URL=http://meta:8080
ENV SUPABASE_URL=https://storage.vps.buyticle.com
ENV SUPABASE_REST_URL=https://rest.vps.buyticle.com
ENV STORAGE_URL=http://storage:5001
ENV NEXT_PUBLIC_STORAGE_URL=https://storage.vps.buyticle.com
# Les clés et le mot de passe viennent de docker-compose (variables Coolify)
ENV STUDIO_DEFAULT_ORGANIZATION=Buyticle
ENV STUDIO_DEFAULT_PROJECT=Inventaire
ENV SUPABASE_FUNCTIONS_URL=""
ENV EDGE_FUNCTIONS_MANAGEMENT_FOLDER=/tmp/functions
ENV IS_PLATFORM=false
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

COPY studio-proxy.js /studio-proxy.js

CMD ["sh", "-c", "node /app/apps/studio/server.js & node -e \"var net=require('net');function w(){var c=net.createConnection(3001,'127.0.0.1');c.once('connect',function(){c.destroy();process.exit(0)});c.once('error',function(){c.destroy();setTimeout(w,500)})}w()\" && exec node /studio-proxy.js"]
