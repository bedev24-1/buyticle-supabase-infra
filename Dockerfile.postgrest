FROM postgrest/postgrest:v12.2.0 AS pgrst

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libpq5 \
       ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pgrst /bin/postgrest /bin/postgrest

# PGRST_DB_URI et PGRST_JWT_SECRET sont fournis par docker-compose (variables Coolify)
ENV PGRST_DB_SCHEMAS="public"
ENV PGRST_DB_ANON_ROLE="anon"
ENV PGRST_DB_USE_LEGACY_GUCS="true"
ENV PGRST_SERVER_HOST="0.0.0.0"

ENTRYPOINT ["/bin/sh", "-c", "\
  CURRENT_UID=$(id -u) && \
  CURRENT_GID=$(id -g) && \
  if ! grep -q \":${CURRENT_UID}:\" /etc/passwd 2>/dev/null; then \
    echo \"pgrst:x:${CURRENT_UID}:${CURRENT_GID}::/tmp:/bin/sh\" >> /etc/passwd; \
  fi && \
  exec /bin/postgrest"]